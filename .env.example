# ===== مُرتّب — إعدادات السيرفر =====
# انسخ هذا الملف باسم .env للتشغيل المحلي، أو حط نفس المتغيرات في لوحة الاستضافة.
# لا ترفع ملف .env إلى GitHub أبدًا (المفتاح سري).

# --- المزوّد ---
# deepseek (الأرخص) أو anthropic أو openai أو mock (للاختبار فقط بدون مفتاح)
# إذا تركته فاضي، السيرفر يختار تلقائيًا حسب المفتاح الموجود.
AI_PROVIDER=deepseek

# --- مفتاح DeepSeek (الأرخص بفارق كبير) ---
# من https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-flash
# وضع التفكير: اتركه disabled (أسرع وأرخص لمحلل بيانات)
DEEPSEEK_THINKING=disabled

# --- مفتاح Anthropic (Claude) ---
# من https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# claude-sonnet-5 = الأفضل توازنًا | claude-haiku-4-5-20251001 = الأرخص عند Anthropic
# ANTHROPIC_MODEL=claude-sonnet-5

# --- مفتاح OpenAI (اختياري) ---
# من https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-5.4-mini

# --- إعدادات اختيارية ---
# الحد الأقصى لتوكنات رد النموذج
MAX_TOKENS=4096
# مهلة الطلب بالمللي ثانية (50000 = 50 ثانية)
REQUEST_TIMEOUT_MS=50000
# عدد محاولات إعادة الاتصال عند خطأ مؤقت من المزوّد
PROVIDER_RETRIES=1
# أقصى عدد صفوف يستقبلها السيرفر من الموقع (الزائد يُقتطع)
MAX_ROWS=400
# أقصى عدد أعمدة
MAX_COLUMNS=60
# أقصى عدد صفوف في الرد النهائي للموقع
MAX_RESULT_ROWS=200
# حد الطلبات لكل IP في الدقيقة (0 = بدون حد)
RATE_LIMIT_PER_MIN=30
# أقصى حجم للطلب
JSON_BODY_LIMIT=2mb
# الدومينات المسموحة للاتصال بالسيرفر (* = الكل، أو https://site.com,https://www.site.com)
ALLOWED_ORIGINS=*
